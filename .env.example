# Example environment variable file
# Copy this file to .env and adjust the values as needed.
# Most settings have built-in defaults in config/__init__.py,
# so this file only includes the options most users are likely to customize.

# ===== Interface =====
LANGUAGE=en_US

# ===== LLM =====
ENABLE_LLM=true
LLM_MODE=local
LLM_LOCAL_HOST=http://localhost:11434
LLM_LOCAL_MODEL=deepseek-r1:7b

# API mode example:
# LLM_MODE=api
# LLM_API_TYPE=openai
# LLM_API_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_API_MODEL=gpt-4

# ===== TTS =====
TTS_ENGINE=edge
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=1.0

# Long text is split into chunks before calling Edge TTS.
# TTS_CHUNK_MAX_CHARS=2000
# TTS_CHUNK_TIMEOUT=180

# Punctuation pauses and lightweight tone changes.
# off = original effect (default), pause = pauses only, prosody = pauses + tone.
TTS_PROSODY_MODE=off
# TTS_PROSODY_MAX_UNIT_CHARS=120

# ===== Output =====
# Source filename (without extension) is appended under this root.
OUTPUT_BASE_PATH=./output
# Comma-separated title prefixes treated as front matter (000 prefix).
# OUTPUT_FRONT_MATTER_MARKERS=导读,前言,序言,引言
OUTPUT_FORMAT=mp3
OUTPUT_BITRATE=128
# OUTPUT_DUPLICATE_HANDLING=rename  # skip / rename / overwrite

# ===== Chapters =====
# Normalize Markdown headings and bold chapter titles before parsing.
CHAPTER_NORMALIZE_ENABLED=true

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
# API_MAX_UPLOAD_SIZE=100  # MB; 0 disables the limit
# API_UPLOAD_DIR=./uploads

# ===== Tasks =====
# Task records are written as readable JSON files and removed when completed.
TASK_CACHE_DIR=./cache/tasks
# TASK_RESULT_TTL=86400  # seconds; 0 keeps records forever

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
