# Example environment variable file
# Copy this file to .env and adjust the values as needed.
# Most settings have built-in defaults in config/__init__.py,
# so this file only includes the options most users are likely to customize.

# ===== Interface =====
LANGUAGE=en_US

# ===== LLM =====
ENABLE_LLM=true
LLM_MODE=local
LLM_LOCAL_HOST=http://localhost:11434
LLM_LOCAL_MODEL=deepseek-r1:7b

# API mode example:
# LLM_MODE=api
# LLM_API_TYPE=openai
# LLM_API_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_API_MODEL=gpt-4

# ===== TTS =====
TTS_MODE=api
TTS_ENGINE=edge
TTS_VOICE=zh-CN-YunxiNeural
TTS_RATE=1.0

# ===== Output =====
OUTPUT_BASE_PATH=./output
OUTPUT_FORMAT=mp3
OUTPUT_BITRATE=128

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== Tasks =====
TASK_QUEUE_TYPE=memory

# Redis queue example:
# TASK_QUEUE_TYPE=redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ===== Logging =====
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

