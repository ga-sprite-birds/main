# ========================================
# GA Sprite Birds — 部署配置示例
# ========================================
# 复制为 .env 后按需修改。
#
# 本文件只放「部署级配置 + 凭证」。
# 语言 / LLM 参数 / TTS / 章节 / 输出 / 文本预处理 / 角色分析等业务配置
# 由 system.db（默认值）+ cache/config/system.json（用户覆盖）提供，
# 在 GUI「系统配置」页修改后立即对新任务生效，不需要重启进程。

# ========== LLM 接入方式与凭证 ==========
# LLM_MODE=local 使用本地 Ollama；LLM_MODE=api 使用 OpenAI 兼容接口。
LLM_MODE=local
LLM_API_TYPE=openai
LLM_API_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=your_api_key_here
LLM_API_MODEL=gpt-4

LLM_LOCAL_HOST=http://localhost:11434
LLM_LOCAL_MODEL=deepseek-r1:7b

# 系统提示词覆盖（留空使用内置提示词）
# LLM_SYSTEM_PROMPT=

# ========== API 服务（对外进程）==========
API_HOST=127.0.0.1
API_PORT=8000
# Host port published by docker-compose (container always listens on 8000).
# API_HOST_PORT=8000
API_DEBUG=false
API_CORS_ENABLED=true
API_CORS_ORIGINS=*
# API_MAX_UPLOAD_SIZE=100  # MB；0 表示不限制
# API_UPLOAD_DIR=./uploads

# ========== 任务调度（Core 引擎）==========
# 引擎同时执行的任务数
TASK_MAX_CONCURRENT=2
# 收到停止信号后等待任务落 checkpoint 的秒数
TASK_GRACE_SECONDS=30
# 终态任务记录保留时长（秒）；0 表示永久保留
TASK_RESULT_TTL=86400

# ========== Redis（预留）==========
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ========== 外部依赖与路径 ==========
# FFmpeg 可执行文件目录（留空使用系统 PATH）
# FFMPEG_PATH=/usr/local/bin
CORE_DIR=ga_birds
# MODEL_CACHE_DIR=./models
# CHARACTER_CACHE_DIR=./cache/role
# DATA_DIR=./data
# RUN_DIR=./run

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=./logs/app.log
LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=5
