# 环境变量示例文件
# 复制此文件为 .env 并填入实际值

# OpenAI API Key（如果使用 API 模式）
OPENAI_API_KEY=your_openai_api_key_here

# 其他 API Key
AZURE_API_KEY=your_azure_api_key_here
ALIYUN_API_KEY=your_aliyun_api_key_here

# Redis 配置（如果使用 Redis 任务队列）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 日志级别
LOG_LEVEL=INFO

