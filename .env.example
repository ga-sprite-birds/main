# ========================================
# GA Sprite Birds — deployment configuration example
# ========================================
# Copy this file to .env and adjust as needed.
#
# This file contains deployment-level settings and credentials only.
# Business settings (language / TTS / chapters / output / text preprocessing /
# character analysis, etc.) come from data/system.db (defaults) +
# cache/config/system.json (user overrides). Edit them in the GUI "System config"
# page; changes apply to new tasks without restarting processes.

# ========== LLM access and credentials ==========
# LLM_MODE=local uses local Ollama; LLM_MODE=api uses an OpenAI-compatible endpoint.
LLM_MODE=local
LLM_API_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=your_api_key_here
LLM_API_MODEL=gpt-4

LLM_LOCAL_HOST=http://localhost:11434
LLM_LOCAL_MODEL=deepseek-r1:7b

# Optional system-prompt override (empty uses the built-in prompt).
# LLM_SYSTEM_PROMPT=

# ========== API service (public process) ==========
API_HOST=127.0.0.1
API_PORT=8000
# Host port published by docker-compose (the container always listens on 8000).
# API_HOST_PORT=8000
API_DEBUG=false
API_CORS_ENABLED=true
API_CORS_ORIGINS=*
# API_MAX_UPLOAD_SIZE=100  # MB; 0 means unlimited
# API_UPLOAD_DIR=./uploads

# ========== Task scheduling (Core engine) ==========
# Maximum number of tasks the engine runs concurrently.
TASK_MAX_CONCURRENT=2
# Seconds to wait for the current task to checkpoint after a stop signal.
TASK_GRACE_SECONDS=30
# Retention for terminal task records (seconds); 0 keeps them forever.
TASK_RESULT_TTL=86400

# ========== External dependencies and paths ==========
# FFmpeg binary directory (empty uses the system PATH).
# FFMPEG_PATH=/usr/local/bin
CORE_DIR=ga_birds
# MODEL_CACHE_DIR=./cache/models
# CHARACTER_CACHE_DIR=./cache/role
# DATA_DIR=./data
# RUN_DIR=./run

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_CONSOLE=true
LOG_FILE=./logs/app.log
LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=5
