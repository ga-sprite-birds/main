# GUI base
# Shared app identity shown in the shell, browser title, header, and footer.
VITE_APP_TITLE=GA Sprite Birds

# Company name used in the footer copyright line.
VITE_COMPANY_NAME=GA Sprite Birds

# Build version shown in footer or diagnostics.
VITE_APP_BUILD_VERSION=b-2026.09.07

# Environment files:
# - .env keeps shared GUI identity.
# - .env.development keeps local development API/theme defaults.
# - .env.production keeps production API/theme defaults.

# Backend host.
# Leave empty in development to use the Vite dev proxy.
VITE_API_BASE_URL=

# Backend proxy target for local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Policy backend API prefix. Keep this as a path, without host.
VITE_API_PREFIX=

# Theme defaults
# VITE_DEFAULT_THEME_FAMILY options: bootstrap / wechat / orange / cherryRed / photoshop
VITE_DEFAULT_THEME_FAMILY=bootstrap

# VITE_DEFAULT_THEME_MODE options: light / dark / system
VITE_DEFAULT_THEME_MODE=system

# Language default: zh_CN / en_US
VITE_DEFAULT_LANG=zh_CN
