# Local development
# Requests use a relative API path and are forwarded by the Vite dev proxy.
VITE_API_BASE_URL=

# Backend proxy target for local development.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# FastAPI path prefix. Keep empty for this project.
VITE_API_PREFIX=

# Theme defaults
# VITE_DEFAULT_THEME_FAMILY options: bootstrap / wechat / orange / cherryRed / photoshop
VITE_DEFAULT_THEME_FAMILY=photoshop

# VITE_DEFAULT_THEME_MODE options: light / dark / system
VITE_DEFAULT_THEME_MODE=system

# Language default: zh_CN / en_US
VITE_DEFAULT_LANG=zh_CN
