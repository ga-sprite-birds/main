# Production template. Adjust User/Group/WorkingDirectory/ExecStart before enabling.
[Unit]
Description=GA Sprite Birds Control API
Documentation=file:///opt/ga-sprite-birds/docs/deploy/README.md
After=network-online.target ga-sprite-birds-core.service
Wants=network-online.target
Requires=ga-sprite-birds-core.service

[Service]
Type=simple
User=gasprite
Group=gasprite
WorkingDirectory=/opt/ga-sprite-birds
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/ga-sprite-birds
# Bind to loopback/private and put Nginx in front; the API has no built-in auth.
ExecStart=/opt/ga-sprite-birds/.venv/bin/python fcgi-bin/api.py
Restart=on-failure
RestartSec=3

# API reads tasks.db; it writes uploads/cache/logs (and seeds data/system.db).
ReadWritePaths=/opt/ga-sprite-birds/uploads /opt/ga-sprite-birds/cache /opt/ga-sprite-birds/logs /opt/ga-sprite-birds/data /opt/ga-sprite-birds/run

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
