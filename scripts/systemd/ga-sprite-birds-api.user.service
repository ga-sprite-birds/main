# Personal/dev template (runs as the invoking user, no root).
# Primary: a project virtualenv. Adjust %h/... to your checkout location.
# Conda is a development environment; if you must, replace ExecStart with:
#   ExecStart=%h/miniconda3/envs/ga-sprite-birds/bin/python -m server run --strict-port
[Unit]
Description=GA Sprite Birds Control API
Documentation=https://github.com/tiger-sprite/ga-sprite-birds
After=network-online.target ga-sprite-birds-core.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ga-sprite-birds
ExecStart=%h/ga-sprite-birds/.venv/bin/python -m server run --strict-port
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
